---
/**
 * The grep wordmark, set in ChessType exactly as printed.
 *
 * The lowercase codepoints are deliberate: ChessType draws its lowercase as
 * the clean outlined pixel letterforms used on the covers, while its uppercase
 * is a heavier filled variant. `stacked` reproduces the two-line lockup.
 */
interface Props {
  stacked?: boolean;
  size?: string;
  class?: string;
}

const { stacked = false, size, class: className = '' } = Astro.props;
---

<span
  class:list={['wordmark', stacked && 'wordmark--stacked', className]}
  style={size ? `--wordmark-size: ${size}` : undefined}
  aria-label="grep"
>
  {
    stacked ? (
      <>
        <span aria-hidden="true">gr</span>
        <span aria-hidden="true">ep</span>
      </>
    ) : (
      <span aria-hidden="true">grep</span>
    )
  }
</span>

<style>
  .wordmark {
    font-family: var(--font-pixel);
    font-size: var(--wordmark-size, var(--step-2));
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: 0.06em;
    -webkit-font-smoothing: none;
    display: inline-block;
  }

  /* ChessType's cap height (1109 units) is taller than its em square (1080),
     so the stacked lockup needs a shade over 1 to keep the rows from touching. */
  .wordmark--stacked {
    display: grid;
    line-height: 1.08;
    letter-spacing: 0.1em;
  }
</style>
