---
import type { Edition } from '../../lib/types';
import { tableOfContents } from '../../lib/editions';

/**
 * The reader's contents rail. Sticky on wide screens, a slide-over sheet on
 * narrow ones. The active item is driven by an IntersectionObserver in
 * `reader.ts` so it tracks the section actually being read.
 */
interface Props {
  edition: Edition;
}

const { edition } = Astro.props;
const toc = tableOfContents(edition);
---

<aside class="reader-rail wave-edge--left" id="reader-rail" data-reader-rail>
  <div class="rail-inner">
    <div class="rail-head">
      <p class="eyebrow">Contents</p>
      <button class="rail-close" type="button" data-rail-close>
        <span class="visually-hidden">Close contents</span>
        <span aria-hidden="true">×</span>
      </button>
    </div>

    <nav aria-label="Sections in this edition">
      <ol class="rail-list">
        {
          toc.map((item, index) => (
            <li>
              <a class="rail-link" href={`#${item.id}`} data-rail-link={item.id} data-accent={item.accent}>
                <span class="rail-num">{String(index + 1).padStart(2, '0')}</span>
                <span class="rail-text">{item.title}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <a class="rail-pdf" href={edition.pdf} download>
      <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
        <path
          d="M8 2v8m0 0L5 7m3 3 3-3M3 13h10"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          fill="none"></path>
      </svg>
      Download the PDF
    </a>
  </div>
</aside>

<button class="rail-trigger no-print" type="button" data-rail-open>
  <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
    <path d="M2 4h12M2 8h12M2 12h8" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
  </svg>
  Contents
</button>

<style>
  .reader-rail {
    --rail-width: 17.5rem;
  }

  .rail-inner {
    display: grid;
    align-content: start;
    gap: 1rem;
  }

  .rail-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .rail-close {
    display: none;
    width: 34px;
    height: 34px;
    place-items: center;
    font-size: var(--step-2);
    line-height: 1;
    border-radius: 8px;
    color: var(--ink-soft);
  }

  .rail-list {
    display: grid;
    gap: 0.1rem;
    /* Long editions must not push the download link off-screen. */
    max-height: min(60vh, 34rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    padding-inline-end: 0.25rem;
  }

  .rail-link {
    display: grid;
    grid-template-columns: 1.9rem minmax(0, 1fr);
    gap: 0.4rem;
    align-items: baseline;
    padding: 0.42rem 0.55rem;
    border-radius: 8px;
    font-size: var(--step--1);
    line-height: 1.35;
    text-decoration: none;
    color: var(--ink-faint);
    transition: background-color 0.18s var(--ease-out), color 0.18s var(--ease-out);
  }

  .rail-link:hover {
    background: color-mix(in srgb, var(--ink) 5%, transparent);
    color: var(--ink);
  }

  .rail-link.is-current {
    background: color-mix(in srgb, var(--blue) 10%, transparent);
    color: var(--blue-deep);
    font-weight: 600;
  }

  .rail-link.is-current[data-accent='red'] {
    background: color-mix(in srgb, var(--red) 12%, transparent);
    color: var(--red-deep);
  }

  .rail-link.is-current[data-accent='ink'] {
    background: color-mix(in srgb, var(--ink) 10%, transparent);
    color: var(--ink);
  }

  .rail-num {
    font-size: var(--step--1);
    opacity: 0.75;
  }

  .rail-pdf {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding-block-start: 0.9rem;
    border-top: 1px solid color-mix(in srgb, var(--ink) 12%, transparent);
    font-size: var(--step--1);
    font-weight: 600;
    text-decoration: none;
    color: var(--blue-deep);
  }

  .rail-pdf:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* The floating trigger only exists below the two-column breakpoint. */
  .rail-trigger {
    display: none;
    position: fixed;
    left: 50%;
    bottom: 1.15rem;
    z-index: 70;
    transform: translateX(-50%);
    align-items: center;
    gap: 0.45rem;
    padding: 0.62em 1.15em;
    border-radius: var(--radius-btn);
    background: var(--blue);
    color: #fff;
    font-size: var(--step--1);
    font-weight: 600;
    box-shadow: 0 14px 30px -14px color-mix(in srgb, var(--blue) 90%, transparent);
  }

  @media (min-width: 64rem) {
    /* Wide enough for the rail to be a column in the page rather than a sheet
       over it - there is no edge to cut, so the mask comes off. */
    .reader-rail {
      -webkit-mask-image: none;
      mask-image: none;
      position: sticky;
      top: 5.5rem;
      align-self: start;
      max-height: calc(100vh - 7rem);
    }
  }

  @media (max-width: 63.99rem) {
    .reader-rail {
      position: fixed;
      inset: 0 0 0 auto;
      z-index: 90;
      width: min(21rem, 88vw);
      /* The wave is cut out of the leading edge, so the copy is padded clear
         of the deepest trough rather than of the box. */
      padding: 1.25rem 1.25rem 1.25rem calc(1.25rem + var(--wave-height));
      background: var(--blue);
      transform: translateX(100%);
      transition: transform 0.34s var(--ease-out);
      overflow-y: auto;
      /* A mask does not clip a box-shadow, so the shadow would have drawn a
         straight edge outside the wavy one. The blue rule carries the edge. */
      box-shadow: none;
    }

    /* The paper fill, inset by the width of the rule and cut to the same wave.
       Two mask layers, like the edge itself: the tile along the leading edge
       and a solid body for the rest. A single tile would only mask its own
       7px of width and leave the fill to stop dead there, which cut the flat
       off every crest. */
    .reader-rail::before {
      content: '';
      position: absolute;
      inset: 0 0 0 2.5px;
      background: var(--paper-card);
      -webkit-mask-image: linear-gradient(#000 0 0), var(--wave-tile);
      mask-image: linear-gradient(#000 0 0), var(--wave-tile);
      -webkit-mask-size: calc(100% - var(--wave-height)) 100%, var(--wave-height) var(--wave-period);
      mask-size: calc(100% - var(--wave-height)) 100%, var(--wave-height) var(--wave-period);
      -webkit-mask-position: 100% 0, 0 50%;
      mask-position: 100% 0, 0 50%;
      -webkit-mask-repeat: no-repeat, repeat-y;
      mask-repeat: no-repeat, repeat-y;
    }

    .rail-inner {
      position: relative;
      z-index: 1;
    }

    .reader-rail[data-open] {
      transform: none;
    }

    .rail-list {
      max-height: none;
      overflow: visible;
    }

    .rail-close {
      display: grid;
    }

    .rail-trigger {
      display: inline-flex;
    }
  }
</style>
