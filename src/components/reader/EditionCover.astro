---
import type { Edition } from '../../lib/types';
import Wordmark from '../Wordmark.astro';
import ScrollHint from '../ScrollHint.astro';
import { editionTitle, readingMinutes } from '../../lib/editions';

/**
 * The edition cover, rebuilt rather than screenshotted.
 *
 * The cover is type on plain paper - no backdrop pattern, so the wordmark
 * never has to fight for contrast, and it costs no network request.
 */
interface Props {
  edition: Edition;
}

const { edition } = Astro.props;
const minutes = readingMinutes(edition);
---

<header class:list={['cover', `cover--${edition.cover}`]}>
  <div class="cover-inner shell">
    <div class="cover-mark">
      <Wordmark stacked size="clamp(3.5rem, 15vw, 9rem)" />
      <p class="cover-by script">by acm-vit</p>
    </div>

    <div class="cover-meta">
      <p class="cover-title">{editionTitle(edition)}</p>
      <p class="cover-tagline">{edition.tagline}</p>

      <ul class="cover-facts">
        <li>{edition.dateline}</li>
        <li>{edition.pages} pages</li>
        {minutes > 0 && <li>~{minutes} min read</li>}
      </ul>
    </div>

    <div class="cover-actions no-print">
      <a class="btn" href="#reader-start">Start reading</a>
      <a class="btn btn--quiet" href={edition.pdf} download>Download PDF</a>
    </div>
  </div>

  <ScrollHint class="cover-scroll" />
</header>

<style>
  .cover {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3rem, 9vw, 6.5rem) clamp(3.5rem, 10vw, 7rem);
    background: var(--paper);
    border-bottom: 1px solid color-mix(in srgb, var(--ink) 10%, transparent);
  }

  /* --- content --- */
  .cover-inner {
    position: relative;
    display: grid;
    justify-items: center;
    gap: clamp(1.4rem, 3.5vw, 2.2rem);
    text-align: center;
  }

  .cover-mark {
    display: grid;
    justify-items: center;
    color: var(--blue);
  }

  .cover-by {
    color: var(--ink);
    margin-block-start: 0.2rem;
  }

  .cover-meta {
    display: grid;
    gap: 0.5rem;
    justify-items: center;
  }

  .cover-title {
    font-size: var(--step-2);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--blue-deep);
  }

  .cover-tagline {
    font-size: var(--step-1);
    color: var(--ink-soft);
    max-width: 32ch;
  }

  .cover-facts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.35rem 0.9rem;
    margin-block-start: 0.35rem;
    font-size: var(--step--1);
    color: var(--ink-faint);
  }

  .cover-facts li + li::before {
    content: '·';
    margin-inline-end: 0.9rem;
    color: color-mix(in srgb, var(--ink) 30%, transparent);
  }

  .cover-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.7rem;
  }

  :global(.cover-scroll) {
    margin-block-start: clamp(2rem, 5vw, 3.5rem);
  }

</style>
