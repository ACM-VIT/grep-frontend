---
import type { Card, Section } from '../../lib/types';
import { entryId } from '../../lib/editions';
import { linkTarget } from '../../lib/links';

/**
 * The bordered project / workshop card from the printed page: cream fill,
 * thick accent rule, pixel title, and - for projects - a small square product
 * mark drawn in CSS rather than shipped as an image.
 */
interface Props {
  items: Card[];
  section: Section;
}

const { items, section } = Astro.props;
---

<div class="cards">
  {
    items.map((item, index) => (
      <article
        class="card project-card"
        id={entryId(section, item.title, item.id)}
        data-reveal
        style={`--reveal-delay:${Math.min(index, 4) * 70}ms`}
      >
        <header class="project-head">
          <div>
            <h3 class="project-title pixel">{item.title}</h3>
            {item.meta && <p class="project-meta">{item.meta}</p>}
          </div>

          {item.logo && (
            <span
              class:list={['project-logo', `project-logo--${item.logo.font ?? 'sans'}`]}
              style={`--logo-bg:${item.logo.bg};--logo-fg:${item.logo.fg}`}
              aria-hidden="true"
            >
              {item.logo.text}
            </span>
          )}
        </header>

        <div class="project-body prose">
          {item.body.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>

        {item.links && item.links.length > 0 && (
          <ul class="project-links">
            {item.links.map((link) => (
              <li>
                <a class="project-link" href={link.href} {...linkTarget(link.href)}>
                  <span>{link.label}</span>
                  <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true">
                    <path
                      d="M4 12L12 4M12 4H6M12 4v6"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      fill="none"
                    />
                  </svg>
                </a>
              </li>
            ))}
          </ul>
        )}
      </article>
    ))
  }
</div>

<style>
  .cards {
    display: grid;
    gap: clamp(1.25rem, 3vw, 2rem);
  }

  .project-card {
    scroll-margin-top: 6rem;
    transition: transform 0.32s var(--ease-out), box-shadow 0.32s var(--ease-out);
  }

  .project-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-card);
  }

  .project-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.25rem;
    margin-block-end: 1.1rem;
  }

  .project-title {
    font-size: var(--step-1);
    color: var(--ink);
    word-break: break-word;
  }

  .project-meta {
    margin-block-start: 0.5rem;
    font-size: var(--step--1);
    color: var(--ink-faint);
  }

  /* The product mark: a rounded tile with the wordmark set inside it. */
  .project-logo {
    flex: none;
    display: grid;
    place-items: center;
    width: clamp(64px, 12vw, 92px);
    aspect-ratio: 1;
    padding: 0.35rem;
    border-radius: 14px;
    background: var(--logo-bg);
    color: var(--logo-fg);
    font-size: clamp(0.5rem, 1.4vw, 0.75rem);
    font-weight: 700;
    letter-spacing: 0.02em;
    text-align: center;
    overflow: hidden;
  }

  .project-logo--pixel {
    font-family: var(--font-pixel);
    -webkit-font-smoothing: none;
  }

  .project-logo--glyph {
    font-size: clamp(1.5rem, 4vw, 2.5rem);
  }

  .project-body {
    color: var(--ink-soft);
  }

  .project-body > p + p {
    margin-block-start: 0.95em;
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block-start: 1.3rem;
  }

  .project-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.62em 1.15em;
    border-radius: var(--radius-btn);
    border: 2px solid color-mix(in srgb, var(--accent) 32%, transparent);
    font-size: var(--step--1);
    font-weight: 600;
    text-decoration: none;
    color: var(--accent-deep);
    transition: background-color 0.2s var(--ease-out), border-color 0.2s var(--ease-out), color 0.2s var(--ease-out);
  }

  .project-link:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-contrast);
  }

  .project-link svg {
    flex: none;
    transition: transform 0.24s var(--ease-spring);
  }

  .project-link:hover svg {
    transform: translate(1.5px, -1.5px);
  }
</style>
