---
import type { Entry, Section } from '../../lib/types';
import { entryId } from '../../lib/editions';
import { linkTarget } from '../../lib/links';

/**
 * The event entry, as printed: a pixel title on a dashed left rail, closed by
 * a dashed rule. The rail is a border rather than an image so it inherits the
 * section accent and stays crisp at any zoom.
 */
interface Props {
  items: Entry[];
  section: Section;
}

const { items, section } = Astro.props;
---

<div class="entries">
  {
    items.map((item, index) => (
      <article class="entry" id={entryId(section, item.title, item.id)} data-reveal style={`--reveal-delay:${Math.min(index, 4) * 60}ms`}>
        <div class="entry-rail" aria-hidden="true" />

        <div class="entry-body">
          <h3 class="entry-title pixel">{item.title}</h3>
          {item.meta && <p class="entry-meta">{item.meta}</p>}

          <div class:list={['entry-copy prose', item.figure && item.figure.align !== 'full' && 'entry-copy--wrapped']}>
            {item.figure && item.figure.align !== 'full' && (
              <figure class="entry-figure">
                <img src={item.figure.src} alt={item.figure.alt} loading="lazy" decoding="async" />
                {item.figure.caption && <figcaption>{item.figure.caption}</figcaption>}
              </figure>
            )}

            {item.body.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>

          {item.links && item.links.length > 0 && (
            <ul class="entry-links">
              {item.links.map((link) => (
                <li>
                  <a class="link" href={link.href} {...linkTarget(link.href)}>
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          )}

          {item.figure && item.figure.align === 'full' && (
            <figure class="entry-figure entry-figure--full">
              <img src={item.figure.src} alt={item.figure.alt} loading="lazy" decoding="async" />
              {item.figure.caption && <figcaption>{item.figure.caption}</figcaption>}
            </figure>
          )}
        </div>
      </article>
    ))
  }
</div>

<style>
  .entries {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4.5rem);
  }

  .entry {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(1rem, 3vw, 1.8rem);
    scroll-margin-top: 6rem;
  }

  /* The dashed rail from the printed page, drawn top-to-bottom then turning
     along the bottom edge to close the entry. */
  .entry-rail {
    width: 2px;
    border-left: 2px dashed color-mix(in srgb, var(--accent) 62%, transparent);
    border-radius: 2px;
  }

  .entry-body {
    padding-block-end: clamp(1.25rem, 3vw, 2rem);
    border-bottom: 2px dashed color-mix(in srgb, var(--accent) 62%, transparent);
  }

  .entry-title {
    font-size: var(--step-2);
    color: var(--accent);
    margin-block-end: 0.9rem;
    word-break: break-word;
  }

  .entry-meta {
    font-size: var(--step--1);
    color: var(--ink-faint);
    margin-block-end: 0.9rem;
  }

  .entry-copy > p + p {
    margin-block-start: 0.95em;
  }

  .entry-copy {
    color: var(--ink-soft);
  }

  /* Photographs sit beside the column in print; float keeps the copy wrapping
     the way it does on the page, and collapses to full width on narrow screens. */
  .entry-copy--wrapped .entry-figure {
    float: right;
    width: min(42%, 15rem);
    margin: 0.35rem 0 1rem 1.4rem;
  }

  .entry-figure img {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    border: 2.5px solid var(--accent);
    background: var(--paper-card);
  }

  .entry-figure figcaption {
    margin-block-start: 0.5rem;
    font-size: var(--step--1);
    color: var(--ink-faint);
  }

  .entry-figure--full {
    margin-block-start: 1.6rem;
  }

  .entry-links {
    display: grid;
    gap: 0.4rem;
    margin-block-start: 1.1rem;
    font-size: var(--step--1);
    clear: both;
  }

  .entry-links a {
    font-weight: 600;
    word-break: break-word;
  }

  @media (max-width: 40rem) {
    .entry {
      grid-template-columns: minmax(0, 1fr);
    }

    .entry-rail {
      display: none;
    }

    .entry-copy--wrapped .entry-figure {
      float: none;
      width: 100%;
      margin: 0 0 1.2rem;
    }
  }
</style>
