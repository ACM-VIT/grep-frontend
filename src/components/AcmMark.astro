---
/**
 * The ACM diamond, taken from the printed editions rather than redrawn.
 *
 * Several versions exist because the newsletter uses several: the stroked line
 * mark on the running band, the heavier blue outline on the back matter, and
 * the metallic mark in print. ACM-W sections get the chapter's own red
 * diamond.
 */
interface Props {
  variant?: 'line' | 'white' | 'metallic' | 'outline' | 'acmw';
  size?: number;
  class?: string;
  label?: string;
}

const { variant = 'line', size = 34, class: className = '', label } = Astro.props;

/* Vectors from the chapter's logo system - the old PNG exports were cropped
   at the diamond's right and bottom points. `line` is the stroked mark the
   running band carries; `outline` is the heavier blue one the printed back
   page opens with; `white` is the solid fill, kept for anywhere that needs a
   silhouette. */
const sources = {
  line: '/logos/acm-line-mark.svg',
  white: '/logos/acm-diamond-white.svg',
  metallic: '/logos/acm-diamond-dark.svg',
  outline: '/logos/acm-diamond-outline.svg',
  acmw: '/logos/acmw-legacy-blue.svg',
} as const;
---

<img
  class:list={['acm-mark', className]}
  src={sources[variant]}
  style={`--mark-size:${size}px`}
  alt={label ?? ''}
  aria-hidden={label ? undefined : 'true'}
  loading="eager"
  decoding="async"
/>

<style>
  .acm-mark {
    flex: none;
    width: var(--mark-size);
    height: auto;
    max-width: 100%;
  }
</style>
