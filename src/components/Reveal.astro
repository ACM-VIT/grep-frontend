---
/**
 * Scroll-reveal wrapper. Adds `is-in` once the element enters the viewport.
 * The observer is registered once per page and picks up any `[data-reveal]`,
 * so this component is only sugar for setting the attribute and the delay.
 */
interface Props {
  delay?: number;
  as?: 'div' | 'section' | 'li' | 'article' | 'header' | 'p';
  class?: string;
}

const { delay = 0, as: Tag = 'div', class: className = '' } = Astro.props;
---

<Tag class={className} data-reveal style={delay ? `--reveal-delay:${delay}ms` : undefined}>
  <slot />
</Tag>
