---
import Base from '../layouts/Base.astro';
import ScrollHint from '../components/ScrollHint.astro';
import SubscribeForm from '../components/SubscribeForm.astro';
import { editions, latestEdition } from '../lib/editions';
import { site, socials } from '../lib/site';
import { linkTarget } from '../lib/links';

/**
 * About grep. The copy is drawn from the editions' own "What is grep?" and
 * "What is ACM-VIT?" pages rather than invented.
 */
const sections = [
  {
    id: 'what-is-grep',
    title: 'What is grep?',
    art: '/art/magnifier.png',
    body: [
      'grep is the official newsletter of ACM-VIT. It is a memoir of the chapter’s campaigns, putting a spotlight on our initiatives, our impactful work, and the people who make it all happen.',
      'From events and technical projects to blogs and internal initiatives, each edition offers a structured overview of our work - context, clarity, and continuity for everything that lies ahead.',
      'More than just a newsletter, grep is your search query for all ACM-VIT updates: the ideas, efforts, and people that shape us.',
    ],
  },
  {
    id: 'why-grep',
    title: 'Why call it grep?',
    art: '/art/code.png',
    body: [
      'grep is the tool you reach for when you know something is in there somewhere and you need to find it. That is what a chapter newsletter is for: a searchable record of what happened, written while it is still fresh.',
      'The name is also a small promise about tone. No press releases, no filler - just the record, with the numbers attached.',
    ],
  },
  {
    id: 'acm-vit',
    title: 'What is ACM-VIT?',
    art: '/art/crowd.png',
    body: [
      'The Association for Computing Machinery is the world’s largest educational and scientific organisation in the field of computing. Established in 1947, ACM publishes technical research, sets industry standards, and supports computing professionals through lifelong learning and career development.',
      'ACM-VIT is the official student chapter of ACM at VIT Vellore. Founded in 2009, it is one of the most prestigious technical chapters on campus, committed to advancing computing as a science and a profession.',
      'We don’t just write code - we ask questions, build with purpose, and learn together. Through hackathons, technical projects and ongoing initiatives, we work to make technology accessible and empower the next generation of computing professionals.',
    ],
  },
  {
    id: 'acm-w',
    title: 'And ACM-W?',
    art: '/art/acmw-flying.png',
    accent: 'red',
    body: [
      'ACM-W was founded with a simple yet powerful mission: to ensure equal opportunities in technology and empower everyone to grow in STEM. Talent and potential should never be limited by barriers, but nurtured through the right support, mentorship, and exposure.',
      'As the sister chapter of ACM-VIT, it is a community that celebrates contributions of women across all computing fields - through the inspiHER series, blogs, projects, and initiatives like Neural Hack.',
    ],
  },
];

const process = [
  {
    step: 'Gather',
    body: 'Editors collect what the chapter did since the last edition - events, project cycles, competitions, talks, open-source work.',
  },
  {
    step: 'Write',
    body: 'Each section is written by someone who was there. Numbers get checked against the registration data, not rounded up.',
  },
  {
    step: 'Design',
    body: 'The design team lays it out in the chapter’s system: ACM blue, ACM-W red, a pixel display face and a script for headings.',
  },
  {
    step: 'Publish',
    body: 'It ships as a PDF and as this site - same content, laid out for the medium you are reading it in.',
  },
];
---

<Base
  title="About"
  description="What grep is, who makes it, and why a student chapter publishes a newsletter."
>
  <section class="head shell">
    <h1 class="head-title script" data-reveal style="--reveal-delay:60ms">Because technology matters</h1>
    <p class="head-lede" data-reveal style="--reveal-delay:120ms">
      grep is how ACM-VIT keeps a record of itself - what we built, what we ran, and who did it. {editions.length}
      editions so far, published from VIT Vellore.
    </p>

    <ScrollHint align="start" class="head-scroll" />
  </section>

  <div class="body shell">
    {
      sections.map((section, index) => (
        <section class="chunk" id={section.id} data-accent={section.accent ?? 'blue'}>
          <div class="chunk-head" data-reveal>
            <h2 class="chunk-title script">{section.title}</h2>
            <img class="chunk-art" src={section.art} alt="" aria-hidden="true" loading="lazy" />
          </div>

          <div class="chunk-body" data-reveal style={`--reveal-delay:${Math.min(index, 3) * 60}ms`}>
            {section.body.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </section>
      ))
    }

    <section class="chunk" id="how-its-made">
      <div class="chunk-head" data-reveal>
        <h2 class="chunk-title script">How an edition is made</h2>
      </div>

      <ol class="process">
        {
          process.map((item, index) => (
            <li data-reveal style={`--reveal-delay:${index * 70}ms`}>
              <span class="process-num pixel">{String(index + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="process-step">{item.step}</h3>
                <p class="process-body">{item.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="chunk" id="elsewhere">
      <div class="chunk-head" data-reveal>
        <h2 class="chunk-title script">Find us elsewhere</h2>
      </div>

      <ul class="socials" data-reveal>
        {
          socials.map((item) => (
            <li>
              <a class="social script" href={item.href} {...linkTarget(item.href)}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>

  <section class="cta">
    <div class="shell cta-inner">
      <div data-reveal>
        <h2 class="cta-title script">Start with the latest</h2>
        <p class="cta-body">
          {latestEdition.blurb}
        </p>
        <a class="btn cta-btn" href={`/read/${latestEdition.slug}`}>Read grep v{latestEdition.number}</a>
      </div>

      <div data-reveal style="--reveal-delay:80ms">
        <SubscribeForm id="about-subscribe" variant="panel" />
      </div>
    </div>
  </section>
</Base>

<style>
  .head-scroll {
    margin-block-start: clamp(1.75rem, 5vw, 2.75rem);
  }

  .head {
    padding-block: clamp(2.5rem, 7vw, 4.5rem) clamp(1.5rem, 4vw, 2rem);
  }

  .head-title {
    color: var(--blue);
    margin-block: 0.3rem 0.8rem;
  }

  .head-lede {
    max-width: 52ch;
    font-size: var(--step-0);
    line-height: 1.5;
    color: var(--ink-soft);
  }

  .body {
    display: grid;
    gap: clamp(2.5rem, 7vw, 4.5rem);
    padding-block: clamp(1.5rem, 4vw, 2.5rem);
  }

  .chunk {
    scroll-margin-top: 6rem;
  }

  .chunk-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-block-end: 1rem;
  }

  .chunk-title {
    color: var(--accent);
  }

  .chunk-art {
    flex: none;
    width: clamp(70px, 14vw, 120px);
    height: auto;
  }

  @media (max-width: 34rem) {
    .chunk-art {
      display: none;
    }
  }

  .chunk-body {
    max-width: var(--measure);
    color: var(--ink-soft);
  }

  .chunk-body > p + p {
    margin-block-start: 0.95em;
  }

  /* --- process --- */
  .process {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
  }

  .process li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.85rem;
    align-items: start;
    padding: clamp(1.1rem, 2.5vw, 1.5rem);
    background: var(--paper-card);
    border: 2.5px solid color-mix(in srgb, var(--blue) 20%, transparent);
    border-radius: var(--radius);
  }

  .process-num {
    font-size: var(--step-0);
    color: color-mix(in srgb, var(--blue) 55%, transparent);
    line-height: 1.3;
  }

  .process-step {
    font-size: var(--step-1);
    letter-spacing: -0.02em;
    margin-block-end: 0.3rem;
  }

  .process-body {
    font-size: var(--step--1);
    line-height: 1.6;
    color: var(--ink-soft);
  }

  /* --- socials --- */
  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem clamp(1.2rem, 4vw, 2.5rem);
  }

  .social {
    color: var(--blue);
    text-decoration: none;
    transition: transform 0.24s var(--ease-spring), color 0.2s var(--ease-out);
    display: inline-block;
  }

  .social:hover {
    transform: translateY(-2px);
    color: var(--blue-deep);
  }

  /* --- cta --- */
  .cta {
    margin-block-start: clamp(3rem, 8vw, 5rem);
    padding-block: clamp(2.5rem, 7vw, 4.5rem);
    background: var(--blue-wash);
    border-block: 1px solid color-mix(in srgb, var(--blue) 18%, transparent);
  }

  .cta-inner {
    display: grid;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
  }

  @media (min-width: 52rem) {
    .cta-inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  .cta-title {
    color: var(--blue);
  }

  .cta-body {
    max-width: 44ch;
    margin-block: 0.5rem 1.2rem;
    color: var(--ink-soft);
    font-size: var(--step-0);
    line-height: 1.6;
  }

  .cta-btn {
    --accent: var(--blue);
    --accent-contrast: #fff;
  }
</style>
