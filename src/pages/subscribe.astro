---
import Base from '../layouts/Base.astro';
import ScrollHint from '../components/ScrollHint.astro';
import SubscribeForm from '../components/SubscribeForm.astro';
import { loadEditions, editionTitle } from '../lib/editions';

/* Rendered on demand: the edition list comes from the admin service. */
export const prerender = false;

const editions = await loadEditions();
const latestEdition = editions[0]!;

/**
 * `?state=` is set by the no-JS fallback in `/api/subscribe`, which redirects
 * here after a plain form POST. With JS the form reports inline instead.
 */
const state = Astro.url.searchParams.get('state');

---

<Base
  title="Subscribe"
  description="Get every edition of grep, the ACM-VIT newsletter, in your inbox."
>
  <section class="head shell">
    <h1 class="head-title script" data-reveal style="--reveal-delay:60ms">Get grep in your inbox</h1>
    <p class="head-lede" data-reveal style="--reveal-delay:120ms">
      {editions.length} editions so far. The next one lands the day it ships - nothing else, ever.
    </p>

    <ScrollHint align="start" class="head-scroll" />
  </section>

  <section class="form-wrap shell">
    {
      state === 'ok' && (
        <p class="flash flash--ok" role="status">
          You’re on the list. See you next edition.
        </p>
      )
    }
    {
      state === 'error' && (
        <p class="flash flash--error" role="alert">
          That didn’t go through. Check the address and try again.
        </p>
      )
    }

    <div data-reveal>
      <SubscribeForm id="page-subscribe" variant="panel" />
    </div>

  </section>

  <section class="meanwhile shell">
    <div class="meanwhile-card" data-reveal>
      <img class="meanwhile-art" src="/art/reading.png" alt="" aria-hidden="true" loading="lazy" />
      <div>
        <h2 class="meanwhile-title script">In the meantime</h2>
        <p class="meanwhile-body">
          {latestEdition.blurb}
        </p>
        <a class="btn meanwhile-btn" href={`/read/${latestEdition.slug}`}>
          Read {editionTitle(latestEdition)}
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* `:global` because the cue's root element belongs to ScrollHint, so this
     page's scoping attribute is never stamped on it. */
  :global(.head-scroll) {
    margin-block-start: clamp(1.75rem, 5vw, 2.75rem);
  }

  .head {
    padding-block: clamp(2.5rem, 7vw, 4.5rem) clamp(1.25rem, 3vw, 2rem);
  }

  .head-title {
    color: var(--blue);
    margin-block: 0.3rem 0.8rem;
  }

  .head-lede {
    max-width: 46ch;
    font-size: var(--step-0);
    line-height: 1.5;
    color: var(--ink-soft);
  }

  /* `.shell` centres the column, so the cap has to sit on the content inside
     it - capping the shell itself would pull the form away from the heading. */
  .form-wrap {
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.5rem);
  }

  .form-wrap > * {
    max-width: 46rem;
  }

  .flash {
    padding: 0.9rem 1.1rem;
    border-radius: var(--radius);
    font-weight: 600;
    font-size: var(--step--1);
  }

  .flash--ok {
    background: var(--blue-wash);
    color: var(--blue-deep);
  }

  .flash--error {
    background: var(--red-wash);
    color: var(--red-deep);
  }

  .meanwhile {
    padding-block: clamp(3rem, 8vw, 5rem) 0;
  }

  .meanwhile-card {
    display: grid;
    gap: clamp(1.25rem, 4vw, 2.5rem);
    align-items: center;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    background: var(--paper-card);
    border: 2.5px solid var(--blue);
    border-radius: var(--radius-lg);
  }

  @media (min-width: 48rem) {
    .meanwhile-card {
      grid-template-columns: clamp(6rem, 16vw, 10rem) minmax(0, 1fr);
    }
  }

  .meanwhile-art {
    width: 100%;
    height: auto;
  }

  .meanwhile-title {
    color: var(--blue);
  }

  .meanwhile-body {
    max-width: 48ch;
    margin-block: 0.4rem 1.2rem;
    font-size: var(--step-0);
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .meanwhile-btn {
    --accent: var(--blue);
    --accent-contrast: #fff;
  }
</style>
