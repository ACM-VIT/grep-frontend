---
import Base from '../layouts/Base.astro';
import ScrollHint from '../components/ScrollHint.astro';
import SubscribeForm from '../components/SubscribeForm.astro';
import { editions, latestEdition, editionTitle } from '../lib/editions';

/**
 * `?state=` is set by the no-JS fallback in `/api/subscribe`, which redirects
 * here after a plain form POST. With JS the form reports inline instead.
 */
const state = Astro.url.searchParams.get('state');

const promises = [
  { title: 'One email per edition', body: 'A few times a year, when there is enough worth writing down. Never a drip campaign.' },
  { title: 'The whole thing', body: 'The full edition, not a teaser with a “read more” wall. Link to the web reader, link to the PDF.' },
  { title: 'No tracking', body: 'No pixels, no open-rate surveillance, no sharing your address with anyone.' },
  { title: 'One click out', body: 'Unsubscribe in every email. No confirmation flow designed to change your mind.' },
];
---

<Base
  title="Subscribe"
  description="Get every edition of grep, the ACM-VIT newsletter, in your inbox."
>
  <section class="head shell">
    <h1 class="head-title script" data-reveal style="--reveal-delay:60ms">Get grep in your inbox</h1>
    <p class="head-lede" data-reveal style="--reveal-delay:120ms">
      {editions.length} editions so far. The next one lands the day it ships - nothing else, ever.
    </p>

    <ScrollHint align="start" class="head-scroll" />
  </section>

  <section class="form-wrap shell">
    {
      state === 'ok' && (
        <p class="flash flash--ok" role="status">
          You’re on the list. See you next edition.
        </p>
      )
    }
    {
      state === 'error' && (
        <p class="flash flash--error" role="alert">
          That didn’t go through. Check the address and try again.
        </p>
      )
    }

    <div data-reveal>
      <SubscribeForm id="page-subscribe" variant="panel" />
    </div>

    <ul class="promises">
      {
        promises.map((item, index) => (
          <li data-reveal style={`--reveal-delay:${index * 70}ms`}>
            <svg class="tick" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
              <path
                d="M3 8.5 6.5 12 13 4.5"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-linejoin="round"
                fill="none"
              />
            </svg>
            <div>
              <h2 class="promise-title">{item.title}</h2>
              <p class="promise-body">{item.body}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="meanwhile shell">
    <div class="meanwhile-card" data-reveal>
      <img class="meanwhile-art" src="/art/reading.png" alt="" aria-hidden="true" loading="lazy" />
      <div>
        <h2 class="meanwhile-title script">In the meantime</h2>
        <p class="meanwhile-body">
          {latestEdition.blurb}
        </p>
        <a class="btn meanwhile-btn" href={`/read/${latestEdition.slug}`}>
          Read {editionTitle(latestEdition)}
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .head-scroll {
    margin-block-start: clamp(1.75rem, 5vw, 2.75rem);
  }

  .head {
    padding-block: clamp(2.5rem, 7vw, 4.5rem) clamp(1.25rem, 3vw, 2rem);
  }

  .head-title {
    color: var(--blue);
    margin-block: 0.3rem 0.8rem;
  }

  .head-lede {
    max-width: 46ch;
    font-size: var(--step-0);
    line-height: 1.5;
    color: var(--ink-soft);
  }

  /* `.shell` centres the column, so the cap has to sit on the content inside
     it - capping the shell itself would pull the form away from the heading. */
  .form-wrap {
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.5rem);
  }

  .form-wrap > * {
    max-width: 46rem;
  }

  .flash {
    padding: 0.9rem 1.1rem;
    border-radius: var(--radius);
    font-weight: 600;
    font-size: var(--step--1);
  }

  .flash--ok {
    background: var(--blue-wash);
    color: var(--blue-deep);
  }

  .flash--error {
    background: var(--red-wash);
    color: var(--red-deep);
  }

  .promises {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
  }

  .promises li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.7rem;
    align-items: start;
  }

  .tick {
    margin-block-start: 0.28rem;
    color: var(--blue);
  }

  .promise-title {
    font-size: var(--step-0);
    font-weight: 600;
    letter-spacing: -0.015em;
    margin-block-end: 0.15rem;
  }

  .promise-body {
    font-size: var(--step--1);
    line-height: 1.55;
    color: var(--ink-soft);
  }

  .meanwhile {
    padding-block: clamp(3rem, 8vw, 5rem) 0;
  }

  .meanwhile-card {
    display: grid;
    gap: clamp(1.25rem, 4vw, 2.5rem);
    align-items: center;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    background: var(--paper-card);
    border: 2.5px solid var(--blue);
    border-radius: var(--radius-lg);
  }

  @media (min-width: 44rem) {
    .meanwhile-card {
      grid-template-columns: clamp(6rem, 16vw, 10rem) minmax(0, 1fr);
    }
  }

  .meanwhile-art {
    width: 100%;
    height: auto;
  }

  .meanwhile-title {
    color: var(--blue);
  }

  .meanwhile-body {
    max-width: 48ch;
    margin-block: 0.4rem 1.2rem;
    font-size: var(--step-0);
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .meanwhile-btn {
    --accent: var(--blue);
    --accent-contrast: #fff;
  }
</style>
