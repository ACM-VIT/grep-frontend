---
import Base from '../layouts/Base.astro';
import { loadEditions } from '../lib/editions';

/* Rendered on demand: the edition list comes from the admin service. */
export const prerender = false;

const editions = await loadEditions();
---

<Base title="Not found" description="That page isn’t here." noindex>
  <section class="lost shell">
    <p class="lost-code" data-reveal>$ grep -r "this page" ./grep</p>
    <h1 class="lost-title script" data-reveal style="--reveal-delay:60ms">No matches found</h1>
    <p class="lost-body" data-reveal style="--reveal-delay:120ms">
      The page you were after isn’t here. It may have moved, or it may never have existed - either way, the archive is
      one click away.
    </p>

    <div class="lost-actions" data-reveal style="--reveal-delay:180ms">
      <a class="btn" href="/">Back to the front page</a>
      <a class="btn btn--quiet" href="/editions">Browse {editions.length} editions</a>
    </div>

    <img class="lost-art" src="/art/thinking.png" alt="" aria-hidden="true" />
  </section>
</Base>

<style>
  .lost {
    display: grid;
    justify-items: start;
    gap: 0.6rem;
    padding-block: clamp(3rem, 12vw, 7rem);
    max-width: 46rem;
  }

  .lost-code {
    font-size: var(--step--1);
    color: var(--ink-faint);
  }

  .lost-title {
    color: var(--blue);
  }

  .lost-body {
    max-width: 44ch;
    font-size: var(--step-0);
    line-height: 1.5;
    color: var(--ink-soft);
  }

  .lost-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-block-start: 1rem;
  }

  .lost-actions .btn {
    --accent: var(--blue);
    --accent-contrast: #fff;
  }

  .lost-art {
    width: clamp(120px, 30vw, 224px);
    margin-block-start: clamp(1.5rem, 5vw, 3rem);
  }
</style>
