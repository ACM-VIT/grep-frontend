{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "grep-frontend",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"compatibility_date": "2026-09-03",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist"
	},
	"observability": {
		"enabled": true
	},
	"routes": [
		{
			"pattern": "grep.acmvit.in",
			"custom_domain": true
		}
	]
}
